# Non-secret mailbox addresses; sending account must match the authorized Gmail account.
CONTACT_TO=
GMAIL_FROM=
# Durable OAuth setup (authorize the gmail.send scope). Supply credentials securely.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# Optional short-lived alternative to the OAuth refresh configuration.
GMAIL_ACCESS_TOKEN=
# Optional exact deployed origin, for example https://your-project.vercel.app
PUBLIC_ORIGIN=
PORT=3000
